# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.sqlite3 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.tar binary
*.gz binary
*.zip binary
