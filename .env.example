# =========================================================================
# Social Gravity — Environment Configuration (.env.example)
# Zero-Cost Production Architecture ($0.00 / month)
# 
# NOTE: All keys in this file are OPTIONAL.
# Social Gravity is architected to run 100% offline and functional
# out-of-the-box using local IndexedDB, Transformers.js in-browser AI,
# and public unauthenticated feeds without any cloud configuration.
# =========================================================================

# -------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# -------------------------------------------------------------------------
VITE_APP_TITLE="Social Gravity"
VITE_APP_VERSION="3.0.0-production"
VITE_ZERO_COST_MODE="true"

# -------------------------------------------------------------------------
# 2. SUPABASE FREE TIER (Database, Auth, Storage)
# Free Plan: 500MB DB, 50,000 MAU Auth, 1GB Storage, Unlimited API calls
# Create free project: https://supabase.com
# -------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# -------------------------------------------------------------------------
# 3. NEON SERVERLESS POSTGRES (Alternative Free Tier DB)
# Free Plan: 0.5 GB storage, autoscaling to zero, zero cold-start lock
# Create free project: https://neon.tech
# -------------------------------------------------------------------------
VITE_NEON_DATABASE_URL=""

# -------------------------------------------------------------------------
# 4. LOCAL AI INFERENCE (Ollama on Host)
# Completely free, runs locally on your laptop / desktop CPU/GPU
# Download: https://ollama.ai (e.g. `ollama run llama3.2:3b`)
# -------------------------------------------------------------------------
VITE_OLLAMA_ENDPOINT="http://localhost:11434"
VITE_OLLAMA_MODEL="llama3.2:3b"

# -------------------------------------------------------------------------
# 5. HUGGING FACE INFERENCE (Optional Free Serverless Token)
# Free Plan: Free serverless inference on community models
# Create free token: https://huggingface.co/settings/tokens
# -------------------------------------------------------------------------
VITE_HUGGINGFACE_TOKEN=""

# -------------------------------------------------------------------------
# 6. SOCIAL DATA INGESTION (All 100% Free / Unauthenticated by Default)
# -------------------------------------------------------------------------
# Bluesky AT Protocol Jetstream firehose endpoint (public websocket)
VITE_BLUESKY_WS_ENDPOINT="wss://jetstream2.us-east.bsky.network/subscribe"

# Mastodon federated instance endpoints (comma-separated public instances)
VITE_MASTODON_INSTANCES="https://mastodon.social,https://mastodon.online,https://hachyderm.io,https://fosstodon.org"

# Reddit target subreddits for live signal analysis (public JSON feeds)
VITE_REDDIT_SUBREDDITS="technology,worldnews,news,science,artificial"

# GitHub personal access token (optional, increases rate limit from 60 to 5,000 req/hr)
VITE_GITHUB_TOKEN=""

# -------------------------------------------------------------------------
# 7. CLOUDFLARE PAGES / WORKERS DEPLOYMENT (For GitHub Actions Secrets)
# Free Plan: Unlimited static bandwidth, 100k edge requests/day
# Obtain from: https://dash.cloudflare.com/profile/api-tokens
# -------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
